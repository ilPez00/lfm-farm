[Unit]
Description=LFM Inference Server — lfm-toolcall-lfm25
After=network.target
Wants=network.target

[Service]
Type=simple
User=gio
WorkingDirectory=/home/gio
ExecStart=/home/gio/llama.cpp/llama-server --model /home/gio/models/lfm2.5-8b-a1b/LFM2.5-8B-A1B-Q4_K_M.gguf --port 8081 --host 127.0.0.1 --threads 4 --ctx-size 32768 --jinja
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/lfm-lfm-toolcall-lfm25.log
StandardError=append:/tmp/lfm-lfm-toolcall-lfm25.log

# Resource limits
MemoryMax=14G
CPUQuota=800%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/gio/models /home/gio/.physis /tmp

[Install]
WantedBy=multi-user.target
